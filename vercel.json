{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/local-roof-intel",
      "destination": "/api/local-roof-intel"
    },
    {
      "source": "/api/submit-lead",
      "destination": "/api/submit-lead"
    },
    {
      "source": "/api/admin/leads",
      "destination": "/api/admin/leads"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

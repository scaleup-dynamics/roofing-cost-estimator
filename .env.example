# GEMINI_API_KEY: Required for Gemini AI API calls and live Search Grounding.
# Optional on Vercel (the app includes verified Austin baseline fallback data if not set).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Optional: Supabase credentials for real-time lead persistence.
# Can also be entered dynamically in the hidden Admin CRM dashboard (?admin).
# Client variables (must be prefixed with VITE_ for Vite bundle exposure):
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Server variables (used by Express / Vercel serverless function):
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
